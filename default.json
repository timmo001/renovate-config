{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    "customManagers:dockerfileVersions",
    "customManagers:githubActionsVersions",
    "group:monorepos",
    "group:recommended"
  ],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "git-submodules": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "minimumReleaseAge": "1 day",
  "customDatasources": {
    "python-precompiled": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/astral-sh/uv/main/crates/uv-python-managed/download-metadata.json",
      "transformTemplates": [
        "($builds := $.*[name = \"cpython\" and os = \"linux\" and arch.family = \"x86_64\" and arch.variant = null and libc = \"gnu\" and variant = null and prerelease = \"\"]; $first := $builds{$string(major) & \".\" & $string(minor) & \".\" & $string(patch): $min($number(build))}; {\"releases\": [$each($first, function($b, $v) {($d := $string($b); $t := $substring($d, 0, 4) & \"-\" & $substring($d, 4, 2) & \"-\" & $substring($d, 6, 2) & \"T00:00:00Z\"; {\"version\": $v, \"date\": $t, \"releaseTimestamp\": $t})})], \"sourceUrl\": \"https://github.com/astral-sh/python-build-standalone\"})"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update exact mise Python pins only to versions with a precompiled Linux build.",
      "managerFilePatterns": [
        "/(^|/)\\.?mise(\\.[^/]+)?\\.toml$/",
        "/(^|/)\\.?mise/config(\\.[^/]+)?\\.toml$/",
        "/(^|/)\\.config/mise/config\\.toml$/"
      ],
      "matchStrings": [
        "(?:^|\\n)python\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "python",
      "datasourceTemplate": "custom.python-precompiled",
      "versioningTemplate": "semver"
    },
    {
      "customType": "jsonata",
      "fileFormat": "yaml",
      "description": "Update standard tool version input defaults in GitHub workflows.",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "$.'on'.*.inputs.'node-version'.default[$type($) = 'string' and $ != ''].{'depName': 'node', 'datasource': 'node-version', 'versioning': 'node', 'currentValue': $}",
        "$.'on'.*.inputs.'bun-version'.default[$type($) = 'string' and $ != ''].{'depName': 'bun', 'datasource': 'npm', 'currentValue': $}",
        "$.'on'.*.inputs.'python-version'.default[$type($) = 'string' and $ != ''].{'depName': 'python', 'datasource': 'python-version', 'versioning': 'python', 'currentValue': $}",
        "$.'on'.*.inputs.'jsr-cli-version'.default[$type($) = 'string' and $ != ''].{'depName': 'jsr', 'datasource': 'npm', 'currentValue': $}",
        "$.'on'.*.inputs.'npm-version'.default[$type($) = 'string' and $ != ''].{'depName': 'npm', 'datasource': 'npm', 'currentValue': $}",
        "$.'on'.*.inputs.'actionlint-version'.default[$type($) = 'string' and $ != ''].{'depName': 'rhysd/actionlint', 'datasource': 'github-releases', 'currentValue': $}"
      ]
    },
    {
      "customType": "jsonata",
      "fileFormat": "json",
      "description": "Update OpenCode references pinned to a release tag. References that follow a branch are left alone.",
      "managerFilePatterns": ["/(^|/)opencode\\.json$/"],
      "matchStrings": [
        "$.references.*[$exists(repository) and $type(branch) = 'string' and $contains(branch, /^v?\\d+\\.\\d+\\.\\d+$/)].{'depName': repository, 'currentValue': branch}"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the shared hk base that hk.pkl amends from a timmo001/workflows release. The tag appears in both the path and the package version.",
      "managerFilePatterns": ["/(^|/)(\\.config/)?hk\\.pkl$/"],
      "matchStrings": [
        "package://github\\.com/timmo001/workflows/releases/download/(?<currentValue>\\d{8}\\.\\d+)/hk-base@\\d{8}\\.\\d+\\.0#"
      ],
      "depNameTemplate": "timmo001/workflows",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^(?<patch>\\d{8})\\.(?<build>\\d+)$",
      "autoReplaceStringTemplate": "package://github.com/timmo001/workflows/releases/download/{{{newValue}}}/hk-base@{{{newValue}}}.0#"
    },
    {
      "customType": "regex",
      "description": "Update the hk schema and builtins that hk configs import. The version appears in both the release tag and the package version.",
      "managerFilePatterns": [
        "/(^|/)(\\.config/)?hk\\.pkl$/",
        "/(^|/)hk/[^/]+\\.pkl$/"
      ],
      "matchStrings": [
        "package://github\\.com/jdx/hk/releases/download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/hk@\\d+\\.\\d+\\.\\d+#"
      ],
      "depNameTemplate": "jdx/hk",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "package://github.com/jdx/hk/releases/download/v{{{newValue}}}/hk@{{{newValue}}}#"
    },
    {
      "customType": "regex",
      "description": "Update annotated container image input defaults in reusable workflows.",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]*#[ \\t]*renovate-container:[ \\t]*datasource=(?<datasource>docker)[ \\t]+(?:depName|packageName)=(?<depName>[^\\s]+)(?:[ \\t]+packageName=(?<packageName>[^\\s]+))?[ \\t]*\\r?\\n[ \\t]*default:[ \\t]*[\"']?[^\\s\"'@]+:(?<currentValue>[a-zA-Z0-9_][a-zA-Z0-9_.-]*)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "autoReplaceStringTemplate": "{{{replace \":[a-zA-Z0-9_.-]+(@sha256:[a-f0-9]{64})?$\" \"\" replaceString}}}:{{#if newValue}}{{{newValue}}}{{else}}{{{currentValue}}}{{/if}}{{#if newDigest}}@{{{newDigest}}}{{else}}{{#if currentDigest}}@{{{currentDigest}}}{{/if}}{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Update exact mise Python pins through the precompiled build list instead of CPython tags.",
      "matchManagers": ["mise"],
      "matchDepNames": ["python"],
      "matchCurrentValue": "/^\\d+\\.\\d+\\.\\d+$/",
      "enabled": false
    },
    {
      "description": "Update the Effect runtime and integrations together.",
      "matchPackageNames": [
        "effect",
        "@effect/**",
        "!@effect/tsgo",
        "!@effect/language-service"
      ],
      "groupName": "Effect",
      "groupSlug": "effect"
    },
    {
      "description": "Keep coordinated OpenCode 2 packages together.",
      "matchDepNames": [
        "@opencode/**",
        "npm:@opencode/**",
        "anomalyco/opencode",
        "github:anomalyco/opencode"
      ],
      "groupName": "OpenCode 2",
      "groupSlug": "opencode-2"
    },
    {
      "description": "Update OpenTUI packages together.",
      "matchPackageNames": ["@opentui/**"],
      "groupName": "OpenTUI",
      "groupSlug": "opentui"
    },
    {
      "description": "Update Lit monorepo packages together.",
      "matchSourceUrls": ["https://github.com/lit/lit"],
      "groupName": "Lit",
      "groupSlug": "lit"
    },
    {
      "description": "Update Oxlint packages together.",
      "matchPackageNames": [
        "oxlint",
        "@oxlint/**",
        "oxlint-tsgolint",
        "eslint-plugin-oxlint"
      ],
      "groupName": "oxlint",
      "groupSlug": "oxlint"
    },
    {
      "description": "Group GitHub Actions.",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Group container images",
      "groupName": "container images",
      "matchManagers": ["dockerfile", "docker-compose"]
    },
    {
      "description": "Use the shorter release delay for fast-moving development dependencies.",
      "matchDepNames": [
        "effect",
        "@effect/**",
        "@opencode/**",
        "npm:@opencode/**",
        "anomalyco/opencode",
        "github:anomalyco/opencode",
        "aqua:earendil-works/pi",
        "aqua:herdrdev/herdr",
        "github:backnotprop/plannotator"
      ],
      "minimumReleaseAge": "2 hours"
    },
    {
      "description": "Update first-party dependencies, including Home Assistant, Music Assistant and Open Home Foundation projects, without a release delay.",
      "matchPackageNames": [
        "@timmo001/**",
        "timmo001/**",
        "https://github.com/timmo001/**",
        "@home-assistant/**",
        "home-assistant/**",
        "https://github.com/home-assistant/**",
        "ghcr.io/home-assistant/**",
        "homeassistant/**",
        "home-assistant-libs/**",
        "https://github.com/home-assistant-libs/**",
        "@music-assistant/**",
        "music-assistant/**",
        "https://github.com/music-assistant/**",
        "ghcr.io/music-assistant/**",
        "@esphome/**",
        "esphome/**",
        "https://github.com/esphome/**",
        "ghcr.io/esphome/**",
        "OHF-Voice/**",
        "https://github.com/OHF-Voice/**",
        "ghcr.io/OHF-Voice/**",
        "@openhomefoundation/**",
        "OpenHomeFoundation/**",
        "https://github.com/OpenHomeFoundation/**",
        "ghcr.io/OpenHomeFoundation/**"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Update registry packages published from first-party, Home Assistant, Music Assistant and Open Home Foundation repositories without a release delay.",
      "matchSourceUrls": [
        "https://github.com/timmo001/**",
        "https://github.com/home-assistant/**",
        "https://github.com/home-assistant-libs/**",
        "https://github.com/music-assistant/**",
        "https://github.com/esphome/**",
        "https://github.com/OHF-Voice/**",
        "https://github.com/OpenHomeFoundation/**"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Follow effect-herdr fork releases (X.Y.Z-timmo001.N) across upstream versions, and skip any plain upstream version.",
      "matchPackageNames": ["@timmo001/effect-herdr"],
      "allowedVersions": "/-timmo001\\.\\d+$/",
      "ignoreUnstable": false
    },
    {
      "description": "Treat every timmo001/workflows CalVer release as a standard update.",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["timmo001/workflows"],
      "versioning": "regex:^(?<patch>\\d{8})\\.(?<build>\\d+)$"
    },
    {
      "description": "Update Git submodules without a release delay.",
      "matchManagers": ["git-submodules"],
      "minimumReleaseAge": null
    },
    {
      "description": "Move vendored Home Assistant frontend submodules between beta and stable release tags only.",
      "matchManagers": ["git-submodules"],
      "matchPackageNames": [
        "https://github.com/home-assistant/frontend",
        "https://github.com/home-assistant/frontend.git"
      ],
      "versioning": "regex:^(?<major>\\d{8})\\.(?<patch>\\d+)$"
    },
    {
      "description": "Skip branch-tracking digest updates for Home Assistant frontend submodules, so they never move to development commits.",
      "matchManagers": ["git-submodules"],
      "matchPackageNames": [
        "https://github.com/home-assistant/frontend",
        "https://github.com/home-assistant/frontend.git"
      ],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    }
  ]
}
