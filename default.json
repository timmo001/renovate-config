{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    "group:monorepos",
    "group:recommended"
  ],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "git-submodules": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "minimumReleaseAge": "1 day",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update annotated tool version ARGs in Dockerfiles.",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/",
        "/(^|/)Dockerfile\\.[^/]*$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+packageName=(?<packageName>[^\\s]+)(?:\\s+versioning=(?<versioning>[^\\s]+))?\\s+ARG\\s+[A-Z0-9_]+_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Update annotated Go tool versions in workflows.",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>[^\\s]+)(?:\\s+versioning=(?<versioning>[^\\s]+))?\\s*\\n\\s*run:\\s*.*?@(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Update annotated tool versions in scripts and workflow env vars.",
      "managerFilePatterns": [
        "/(^|/)\\.github/scripts/.+$/",
        "/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+packageName=(?<packageName>[^\\s]+)(?:\\s+versioning=(?<versioning>[^\\s]+))?\\s*\\n\\s*\\$?[A-Za-z_][A-Za-z0-9_]*\\s*[:=]\\s*[\"']?(?<currentValue>[^\\s\"']+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Update annotated runtime version input defaults in reusable workflows.",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>[^\\s]+)(?:\\s+versioning=(?<versioning>[^\\s]+))?\\s*\\n\\s*default:\\s*\"(?<currentValue>[^\"]+)\"",
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>[^\\s]+)(?:\\s+versioning=(?<versioning>[^\\s]+))?\\s*\\n\\s*[a-z-]+:\\s*\\$\\{\\{[^}]*\\|\\|\\s*'(?<currentValue>[^']+)'",
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>[^\\s]+)(?:\\s+versioning=(?<versioning>[^\\s]+))?\\s*\\n\\s*wget\\s+\\S*/releases/download/v(?<currentValue>[^/\"]+)/"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Update annotated container image input defaults in reusable workflows.",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate-container:\\s*datasource=(?<datasource>docker)\\s+depName=(?<depName>[^\\s]+)\\s*\\n\\s*default:\\s*\"[^\"]+:(?<currentValue>[^@\"\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Update the Effect runtime and integrations together.",
      "matchPackageNames": [
        "effect",
        "@effect/**",
        "!@effect/tsgo",
        "!@effect/language-service"
      ],
      "groupName": "Effect",
      "groupSlug": "effect"
    },
    {
      "description": "Keep coordinated OpenCode 1 packages together.",
      "matchDepNames": [
        "opencode-ai",
        "npm:opencode-ai",
        "@opencode-ai/**",
        "npm:@opencode-ai/**",
        "!@opencode-ai/browser-control",
        "!npm:@opencode-ai/browser-control"
      ],
      "groupName": "OpenCode 1",
      "groupSlug": "opencode-1"
    },
    {
      "description": "Keep coordinated OpenCode 2 packages together.",
      "matchDepNames": [
        "@opencode/**",
        "npm:@opencode/**",
        "anomalyco/opencode",
        "github:anomalyco/opencode"
      ],
      "groupName": "OpenCode 2",
      "groupSlug": "opencode-2"
    },
    {
      "description": "Update OpenTUI packages together.",
      "matchPackageNames": ["@opentui/**"],
      "groupName": "OpenTUI",
      "groupSlug": "opentui"
    },
    {
      "description": "Update Lit monorepo packages together.",
      "matchSourceUrls": ["https://github.com/lit/lit"],
      "groupName": "Lit",
      "groupSlug": "lit"
    },
    {
      "description": "Update Oxlint packages together.",
      "matchPackageNames": [
        "oxlint",
        "@oxlint/**",
        "oxlint-tsgolint",
        "eslint-plugin-oxlint"
      ],
      "groupName": "oxlint",
      "groupSlug": "oxlint"
    },
    {
      "description": "Group GitHub Actions.",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Group container images",
      "groupName": "container images",
      "matchManagers": ["dockerfile", "docker-compose"]
    },
    {
      "description": "Use the shorter release delay for fast-moving development dependencies.",
      "matchDepNames": [
        "effect",
        "@effect/**",
        "@opencode/**",
        "npm:@opencode/**",
        "@opencode-ai/**",
        "npm:@opencode-ai/**",
        "opencode-ai",
        "npm:opencode-ai",
        "anomalyco/opencode",
        "github:anomalyco/opencode",
        "aqua:earendil-works/pi",
        "aqua:herdrdev/herdr",
        "github:backnotprop/plannotator"
      ],
      "minimumReleaseAge": "2 hours"
    },
    {
      "description": "Update first-party dependencies without a release delay.",
      "matchPackageNames": [
        "@timmo001/**",
        "timmo001/**",
        "https://github.com/timmo001/**"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Update Git submodules without a release delay.",
      "matchManagers": ["git-submodules"],
      "minimumReleaseAge": null
    }
  ]
}
